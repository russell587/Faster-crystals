{
	"schemaVersion": 1,
	"id": "fastercrystals",
	"version": "${version}",
	"name": "Faster Crystals",
	"description": "A lightweight Fabric mod for crystal PvP. Instantly places crystals on obsidian/bedrock with zero delay using direct packets. Allows 2 attacks per tick (1 if ping <50ms) on crystals by removing entity client-side after first hit.",
	"authors": [
		"russell587"
	],
	"contact": {
		"homepage": "https://github.com/russell587/Faster-crystals",
		"sources": "https://github.com/russell587/Faster-crystals"
	},
	"license": "CC0-1.0",
	"icon": "assets/fastercrystals/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.ExampleMod"
		],
		"client": [
			"com.example.client.ExampleModClient"
		]
	},
	"mixins": [
		"modid.mixins.json",
		{
			"config": "modid.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
